                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Installers")]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key=".msix" DisplayName="Installers (.msix)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[DestinationFolder]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Installers")]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key=".txt" DisplayName="Text (.txt)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[DestinationFolder]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Text")]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key=".log" DisplayName="Text (.log)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[DestinationFolder]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Text")]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key=".md" DisplayName="Text (.md)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[DestinationFolder]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Text")]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key=".json" DisplayName="Text (.json)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[DestinationFolder]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Text")]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key=".xml" DisplayName="Text (.xml)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[DestinationFolder]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OrganizedFolder, "Text")]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </Switch>
                    <Assign DisplayName="Build Destination Path (Assign)">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[DestinationFile]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(DestinationFolder, CurrentFile.Name)]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <Assign DisplayName="Reset Collision Index (Assign)">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:Int32">[CollisionIndex]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:Int32">[0]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <While Condition="[System.IO.File.Exists(DestinationFile)]" DisplayName="Find Free File Name (While)">
                      <Sequence DisplayName="Try Next Name">
                        <Assign DisplayName="Next Collision Index (Assign)">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Int32">[CollisionIndex]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Int32">[CollisionIndex + 1]</InArgument>
                          </Assign.Value>
                        </Assign>
                        <Assign DisplayName="Build Renamed Path (Assign)">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[DestinationFile]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(DestinationFolder, System.IO.Path.GetFileNameWithoutExtension(CurrentFile.Name) &amp; " (" &amp; CollisionIndex.ToString() &amp; ")" &amp; CurrentFile.Extension)]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </While>
                    <ui:MoveFile ContinueOnError="{x:Null}" DestinationResource="{x:Null}" PathResource="{x:Null}" Destination="[DestinationFile]" DisplayName="Move File" Overwrite="False" Path="[CurrentFile.FullName]" />
                    <Assign DisplayName="Count Moved (Assign)">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:Int32">[FilesMoved]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:Int32">[FilesMoved + 1]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <If Condition="[CollisionIndex &gt; 0]" DisplayName="Was Renamed? (If)">
                      <If.Then>
                        <Sequence DisplayName="Record Rename">
                          <ui:LogMessage DisplayName="Log Renamed File" Level="Warn" Message="[&quot;Name already existed, renamed: &quot; &amp; CurrentFile.Name &amp; &quot; -&gt; &quot; &amp; System.IO.Path.GetFileName(DestinationFile)]" />
                          <Assign DisplayName="Count Renamed (Assign)">
                            <Assign.To>
                              <OutArgument x:TypeArguments="x:Int32">[FilesRenamed]</OutArgument>
                            </Assign.To>
                            <Assign.Value>
                              <InArgument x:TypeArguments="x:Int32">[FilesRenamed + 1]</InArgument>
                            </Assign.Value>
                          </Assign>
                        </Sequence>
                      </If.Then>
                    </If>
                    <ui:LogMessage DisplayName="Log Moved File" Level="Info" Message="[&quot;Moved: &quot; &amp; CurrentFile.Name &amp; &quot; -&gt; &quot; &amp; DestinationFile]" />
                  </Sequence>
                  </If.Else>
                </If>
              </Sequence>
              </TryCatch.Try>
              <TryCatch.Catches>
                <Catch x:TypeArguments="s:Exception">
                  <ActivityAction x:TypeArguments="s:Exception">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Handle File Error">
                      <ui:LogMessage DisplayName="Log Failed File" Level="Error" Message="[&quot;Failed to move &quot; &amp; CurrentFile.Name &amp; &quot;: &quot; &amp; exception.Message]" />
                      <Assign DisplayName="Count Failed (Assign)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Int32">[FilesFailed]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Int32">[FilesFailed + 1]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </ActivityAction>
                </Catch>
              </TryCatch.Catches>
            </TryCatch>
          </Sequence>
        </ActivityAction>
      </ui:ForEachFileX.Body>
    </ui:ForEachFileX>
    <If Condition="[FilesFailed &gt; 0]" DisplayName="Report Summary (If)">
      <If.Then>
        <ui:LogMessage DisplayName="Log Summary With Failures" Level="Warn" Message="[&quot;File Organizer finished. Total: &quot; &amp; FilesTotal.ToString() &amp; &quot; | Moved: &quot; &amp; FilesMoved.ToString() &amp; &quot; (renamed to avoid overwrite: &quot; &amp; FilesRenamed.ToString() &amp; &quot;)&quot; &amp; &quot; | Skipped: &quot; &amp; FilesSkipped.ToString() &amp; &quot; | Failed: &quot; &amp; FilesFailed.ToString() &amp; &quot; - check the log for failed files.&quot;]" />
      </If.Then>
      <If.Else>
        <ui:LogMessage DisplayName="Log Summary" Level="Info" Message="[&quot;File Organizer finished. Total: &quot; &amp; FilesTotal.ToString() &amp; &quot; | Moved: &quot; &amp; FilesMoved.ToString() &amp; &quot; (renamed to avoid overwrite: &quot; &amp; FilesRenamed.ToString() &amp; &quot;)&quot; &amp; &quot; | Skipped: &quot; &amp; FilesSkipped.ToString() &amp; &quot; | Failed: &quot; &amp; FilesFailed.ToString()]" />
      </If.Else>
    </If>
  </Sequence>
</Activity>